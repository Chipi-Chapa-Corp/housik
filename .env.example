DATABASE_PATH=./data/housik.sqlite
UPLOAD_DIR=./data/receipts
# LLM receipt scanning. Leave the key empty to review receipts manually.
OPENAI_API_KEY=
# Model used to read receipt images/PDFs with structured JSON output.
OPENAI_MODEL=gpt-6.1-sol
# Reasoning models only: low, medium, high, etc. Empty uses the provider default.
OPENAI_REASONING_EFFORT=low
# Optional USD / 1M token rates. Set input, cached input and output together.
# GPT-6.1 Sol and GPT-6 Luna use published reference estimates when these are empty.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_CACHE_WRITE_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Full Responses API endpoint (not a base URL).
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# Optional override for a compatible exchange-rate provider (no key required by default).
EXCHANGE_RATE_URL=https://api.frankfurter.dev/v2/rate/EUR/CZK
# Public browser URL. For Funnel, use its exact https://...ts.net URL
# (include :8443 if Funnel uses that public port). Local app port stays below.
ORIGIN=http://localhost:4827
BODY_SIZE_LIMIT=12M

# Compose host binding. Update ORIGIN too when changing the host port.
HOUSIK_PORT=4827
HOUSIK_BIND=127.0.0.1
