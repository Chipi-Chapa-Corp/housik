DATABASE_PATH=./data/housik.sqlite
UPLOAD_DIR=./data/receipts
# Receipt scanning is optional; manual expenses work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set to your public URL when running the production build.
ORIGIN=http://localhost:3000
BODY_SIZE_LIMIT=12M

# Compose host binding. Update ORIGIN too when changing the host port.
HOUSIK_PORT=3000
HOUSIK_BIND=127.0.0.1
